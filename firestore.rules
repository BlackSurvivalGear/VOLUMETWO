rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperadmin() { return signedIn() && request.auth.token.email == 'admin@lawal.org'; }
    function ownProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return isSuperadmin() || (signedIn() && ownProfile().data.role == 'admin'); }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && uid == request.auth.uid && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email && request.resource.data.suspended == false && request.resource.data.plan == 'free' && request.resource.data.accountStatus == 'active' && request.resource.data.businessId == null && (request.resource.data.role == 'member' || (isSuperadmin() && request.resource.data.role == 'superadmin'));
      allow update: if signedIn() && uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.email == resource.data.email && request.resource.data.role == resource.data.role && request.resource.data.suspended == resource.data.suspended && request.resource.data.plan == resource.data.get('plan', 'free') && request.resource.data.accountStatus == resource.data.get('accountStatus', resource.data.get('suspended', false) ? 'suspended' : 'active') && (request.resource.data.businessId == resource.data.get('businessId', null) || (resource.data.get('businessId', null) == null && request.resource.data.businessId == request.auth.uid)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','phone','lastSignInAt','lastActiveAt','updatedAt','plan','accountStatus','businessId']) || isSuperadmin() && uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.email == resource.data.email && request.resource.data.role == 'superadmin' && request.resource.data.suspended == resource.data.suspended && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','updatedAt']) || isSuperadmin() && uid != request.auth.uid && resource.data.email != 'admin@lawal.org' && request.resource.data.uid == resource.data.uid && request.resource.data.email == resource.data.email && request.resource.data.role in ['member','pro','admin'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','suspended','accountStatus','plan','updatedAt']) || isAdmin() && !isSuperadmin() && uid != request.auth.uid && resource.data.role in ['member','pro'] && request.resource.data.role in ['member','pro'] && request.resource.data.uid == resource.data.uid && request.resource.data.email == resource.data.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','suspended','accountStatus','updatedAt']);
      allow delete: if isSuperadmin() && uid != request.auth.uid && resource.data.email != 'admin@lawal.org' || isAdmin() && !isSuperadmin() && uid != request.auth.uid && resource.data.role in ['member','pro'];
    }

    match /businesses/{businessId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin() || resource.data.get('directoryListed', false) == true);
      allow create: if signedIn() && businessId == request.auth.uid && request.resource.data.ownerUid == request.auth.uid && request.resource.data.name is string && request.resource.data.get('logoDataUrl','') is string && request.resource.data.get('logoDataUrl','').size() <= 320000 && request.resource.data.get('directoryListed', false) is bool && request.resource.data.get('memberName','') is string && request.resource.data.get('memberName','').size() <= 120 && request.resource.data.get('services','') is string && request.resource.data.get('services','').size() <= 500;
      allow update: if signedIn() && businessId == request.auth.uid && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.get('logoDataUrl','') is string && request.resource.data.get('logoDataUrl','').size() <= 320000 && request.resource.data.get('directoryListed', false) is bool && request.resource.data.get('memberName','') is string && request.resource.data.get('memberName','').size() <= 120 && request.resource.data.get('services','') is string && request.resource.data.get('services','').size() <= 500 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','type','email','phone','registrationNumber','taxNumber','country','city','services','website','address','ownerTitle','logoDataUrl','memberName','directoryListed','updatedAt']);
      allow delete: if signedIn() && businessId == request.auth.uid && resource.data.ownerUid == request.auth.uid;
    }

    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid && request.resource.data.type in ['notice','question'] && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120 && request.resource.data.body is string && request.resource.data.body.size() >= 5 && request.resource.data.body.size() <= 2000;
      allow update: if signedIn() && resource.data.authorUid == request.auth.uid && request.resource.data.authorUid == resource.data.authorUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type','title','body','updatedAt']);
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid && request.resource.data.body is string && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 1000 && (request.resource.data.parentReplyId == null || request.resource.data.parentReplyId is string);
        allow update: if signedIn() && resource.data.authorUid == request.auth.uid && request.resource.data.authorUid == resource.data.authorUid && request.resource.data.parentReplyId == resource.data.parentReplyId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','updatedAt']);
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    match /opportunities/{opportunityId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['type','title','body','location','closingDate','url','authorUid','authorName','createdAt','updatedAt']) && request.resource.data.authorUid == request.auth.uid && request.resource.data.type in ['collaboration','contract','supplier','tender','referral','service','other'] && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120 && request.resource.data.body is string && request.resource.data.body.size() >= 10 && request.resource.data.body.size() <= 2500 && request.resource.data.location is string && request.resource.data.location.size() <= 100 && request.resource.data.closingDate is string && request.resource.data.closingDate.size() <= 10 && request.resource.data.url is string && request.resource.data.url.size() <= 500 && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 120;
      allow update: if signedIn() && resource.data.authorUid == request.auth.uid && request.resource.data.authorUid == resource.data.authorUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type','title','body','location','closingDate','url','updatedAt']);
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }
  }
}
