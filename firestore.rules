rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperadmin() { return signedIn() && request.auth.token.email == 'admin@lawal.org'; }
    function ownProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return isSuperadmin() || (signedIn() && ownProfile().data.role == 'admin'); }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.suspended == false
        && request.resource.data.plan == 'free'
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.businessId == null
        && (request.resource.data.role == 'member' || (isSuperadmin() && request.resource.data.role == 'superadmin'));

      allow update: if
        signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.suspended == resource.data.suspended
        && request.resource.data.plan == resource.data.get('plan', 'free')
        && request.resource.data.accountStatus == resource.data.get('accountStatus', resource.data.get('suspended', false) ? 'suspended' : 'active')
        && (request.resource.data.businessId == resource.data.get('businessId', null)
            || (resource.data.get('businessId', null) == null && request.resource.data.businessId == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'phone', 'lastSignInAt', 'lastActiveAt', 'updatedAt',
          'plan', 'accountStatus', 'businessId'
        ])

        || isSuperadmin()
          && uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == 'superadmin'
          && request.resource.data.suspended == resource.data.suspended
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])

        || isSuperadmin()
          && uid != request.auth.uid
          && resource.data.email != 'admin@lawal.org'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role in ['member', 'pro', 'admin']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'suspended', 'accountStatus', 'plan', 'updatedAt'
          ])

        || isAdmin()
          && !isSuperadmin()
          && uid != request.auth.uid
          && resource.data.role in ['member', 'pro']
          && request.resource.data.role in ['member', 'pro']
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'suspended', 'accountStatus', 'updatedAt'
          ]);

      allow delete: if isSuperadmin()
        && uid != request.auth.uid
        && resource.data.email != 'admin@lawal.org'
        || isAdmin()
        && !isSuperadmin()
        && uid != request.auth.uid
        && resource.data.role in ['member', 'pro'];
    }

    match /businesses/{businessId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && businessId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string;

      allow update: if signedIn()
        && businessId == request.auth.uid
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'type', 'email', 'phone', 'website', 'address', 'updatedAt'
        ]);

      allow delete: if signedIn()
        && businessId == request.auth.uid
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
